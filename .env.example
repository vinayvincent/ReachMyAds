# Resend API key for contact form emails
# Get yours at https://resend.com
# When not set, emails are logged to console (dev mode)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Search engine ownership checks (optional). Paste only the token value.
# Google Search Console: Settings > Ownership verification > HTML tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools: the content of the msvalidate.01 meta tag
NEXT_PUBLIC_BING_SITE_VERIFICATION=
